{
  "format": "speed-graph-pack",
  "version": 1,
  "id": "trefoil-knot",
  "name": "Trefoil knot",
  "author": "Anthirayas",
  "license": "0BSD",
  "description": "A parametric curve in 3D: notes gather along a trefoil knot. A good first example of writing your own formulas.",
  "shapes": [
    {
      "id": "trefoil",
      "name": "Trefoil",
      "kind": "parametric",
      "t": [
        0,
        6.2832
      ],
      "x": "(sin(t) + 2*sin(2*t))/3",
      "y": "(cos(t) - 2*cos(2*t))/3",
      "z": "-sin(3*t)/3",
      "thickness": 0.06,
      "samples": 3000
    }
  ],
  "layouts": [
    {
      "id": "trefoil-3d",
      "name": "Trefoil (3D)",
      "dimensions": 3,
      "shape": "trefoil"
    }
  ]
}
