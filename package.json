{
  "name": "fast-graph",
  "version": "0.1.0",
  "description": "Explore very large vaults in a graph view that stays smooth, with filters, local graph, optional 3D, shape layouts and gentle motion effects.",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "build:wasm": "cd core && wasm-pack build --release --target web --out-dir pkg && rm -f pkg/.gitignore && cp pkg/fastgraph_core_bg.wasm ../src/generated/core.wasm",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-out --log-level=warning && node --test \".test-out/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jiti": "2.7.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrayas/fast-graph.git"
  },
  "homepage": "https://github.com/jrayas/fast-graph#readme",
  "bugs": {
    "url": "https://github.com/jrayas/fast-graph/issues"
  }
}
